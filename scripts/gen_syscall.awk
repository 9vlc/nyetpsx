BEGIN {
	FS = "|"

	if (E == "s") {
		print "# Generated by gen_syscall.awk, DO NOT EDIT"
		print ""
		print ".set noreorder"
	} else if (E == "h") {
		print "/* Generated by gen_syscall.awk, DO NOT EDIT */"
		print ""
		print "#ifndef _SYS_SYSCALL_H"
		print "#define _SYS_SYSCALL_H"
		print ""
		print "#include <stdint.h>"
		print "#include <stddef.h>"
		print ""
	} else {
		print "usage: awk -f gen_syscall.awk -v E=s syscall.tbl > syscall.s" > "/dev/stderr"
		print "       awk -f gen_syscall.awk -v E=h syscall.tbl > syscall.h" > "/dev/stderr"
		exit(1)
	}
}

END {
	if (E == "h") {
		print ""
		print "#endif /* _SYS_SYSCALL_H */"
	}
}

function strip_sp(str) {
	gsub(/^[ \t]+/, "", str)
	gsub(/[ \t]+$/, "", str)
	return str
}

function emit_s(name, table, call, pre) {
	print ""
	if (pre) {
		print pre
	}
	print ".section .text." name ", \"ax\", @progbits"
	print ".global " name
	print ".type " name ", @function"
	print name ":"

	print "\tli $t2, " table
	print "\tjr $t2"
	print "\tli $t1, " call
}

function emit_s_syscall(name, table, call, pre) {
	print ""
	if (pre) {
		print pre
	}
	print ".section .text." name ", \"ax\", @progbits"
	print ".global " name
	print ".type " name ", @function"
	print name ":"

	if (name == "sys_change_thread_sub_function") {
		print "\tmove $a1, $a0"
	}
	print "\tli $a0, " call
	print "\tsyscall 0"
	print "\tjr $ra"
	print "\tnop"
}

function emit_h(name, rtype, args, comment) {
	if (comment) {
		print "/* " comment " */"
	}
	print rtype" "name"("args");"
}

/^#/{ next }

# table | calladdr | return | name | args [| comment]
/.+\|.+\|.+\|.+\|.+/ {
	t_table   = strip_sp($1)
	t_call    = strip_sp($2)
	t_rtype   = strip_sp($3)
	t_name    = "sys_" strip_sp($4)
	t_args    = strip_sp($5)
	t_comment = strip_sp($6)

	gsub(/%A/, tolower(t_call), t_name)

	if (E == "s") {
		cmt = (t_comment ? "# " t_comment "\n" : "")
		cmt = cmt "# " t_rtype" "t_name"("t_args")"

		if (t_table == "S") {
			emit_s_syscall(t_name, "0x"t_table, "0x"t_call, cmt)
		} else {
			emit_s(t_name, "0x"t_table, "0x"t_call, cmt)
		}
	} else if (E == "h") {
		emit_h(t_name, t_rtype, t_args, t_comment)
	}
}
